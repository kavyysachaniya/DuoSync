# ==============================================================================
# DuoSync — Safe Environment Variables Example
# Duplicate this file to '.env' (for local development) or configure in Vercel.
# ==============================================================================

# 1. Primary Database: Neon Serverless PostgreSQL (MANDATORY)
# Obtain your pooled connection string from: https://console.neon.tech
# Project Dashboard -> Connection Details -> Check 'Pooled connection' -> PostgreSQL
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-YOUR-PROJECT-POOLER.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# 2. Authentication & Session Security (MANDATORY in Production)
# 32+ character random secret for signing persistent JSON Web Tokens.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="duosync-secure-production-jwt-token-secret-replace-with-random-string-2026"

# 3. Administrative Reset Secret (OPTIONAL)
# Secret required to trigger complete database purge via POST /api/admin/reset
ADMIN_SECRET="duosync-admin-reset-secret-2026"

# 4. Cloud Object Storage for Outfit & Wardrobe Photos (OPTIONAL)
# If using Supabase Storage (Bucket: 'wardrobe-images'):
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Or if using Cloudinary:
# CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
# CLOUDINARY_UPLOAD_PRESET="duosync_wardrobe_preset"
