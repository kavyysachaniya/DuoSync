# ==============================================================================
# DuoSync — Environment Variables Configuration
# ==============================================================================

# 1. Primary Database: Neon Serverless PostgreSQL
# Get your connection string from https://console.neon.tech -> Project -> Dashboard -> Connection String
# Must be added to Vercel Project Settings > Environment Variables for production!
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-ENDPOINT.neon.tech/neondb?sslmode=require"

# 2. Authentication & Security
# Long-lived JWT secret for session token signing and verification
JWT_SECRET="duosync-jwt-secure-production-secret-token-key-2026"

# 3. Administrative Reset Secret
# Secret key required to trigger a full database wipe/reset via POST /api/admin/reset
ADMIN_SECRET="duosync-reset-2026"

# 4. Cloud Object Storage for Wardrobe & Outfits (Optional)
# If using Supabase Storage (bucket: 'wardrobe-images'):
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Or if using Cloudinary:
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_PRESET="duosync_wardrobe"

# 5. Gemini AI Assistant (Optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 6. Hosted Application URL
APP_URL="https://duopulse18.vercel.app"
